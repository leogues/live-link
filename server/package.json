    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
