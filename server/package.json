{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "watch": "tsc -w",
    "dev": "npm run build && concurrently --kill-others \"npm run watch\" \"node --watch dist/server.js\"",
    "prod": "prisma migrate deploy && node dist/server.js",
    "audit": "npm audit --audit-level=moderate",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
