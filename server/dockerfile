FROM --platform=$BUILDPLATFORM node:26.13.0-bookworm-slim AS builder
WORKDIR /backend
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

FROM node:26.13.0-bookworm-slim
WORKDIR /backend
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=builder /backend/dist ./dist
COPY --from=builder /backend/prisma ./prisma
COPY --from=builder /backend/prisma.config.ts ./prisma.config.ts
COPY --from=builder /backend/public ./public
RUN npx prisma --version
EXPOSE 8080
CMD ["npm", "run", "prod"]
